<Window
    x:Class="LockScreenHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LockScreen Hub">

    <ScrollViewer>
        <Grid Padding="28" RowSpacing="18" MaxWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="LockScreen Hub"
                           FontSize="32"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Keep Weather. Remove the clutter. Bring useful notifications to your lock screen."
                           Opacity="0.75"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Lock-screen content" FontSize="20" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="WeatherSwitch"
                                  Header="Keep Windows Weather"
                                  IsOn="True"
                                  OffContent="Off"
                                  OnContent="On"/>
                    <TextBlock Text="This app does not replace Windows' secure lock screen. It keeps the native Weather widget and configures notification behavior."
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Notification access" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccessStatusText"
                               Text="Not checked yet."
                               Opacity="0.75"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Grant notification access"
                                Click="GrantNotificationAccess_Click"/>
                        <Button Content="Refresh status"
                                Click="RefreshStatus_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Providers" FontSize="20" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="WindowsNotificationsSwitch"
                                  Header="Windows app notifications"
                                  IsOn="True"/>
                    <ToggleSwitch x:Name="SteamSwitch"
                                  Header="Steam download monitor"
                                  IsOn="True"/>
                    <ToggleSwitch x:Name="WhatsAppSwitch"
                                  Header="WhatsApp notifications"
                                  IsOn="True"/>
                    <ToggleSwitch x:Name="StoreSwitch"
                                  Header="Microsoft Store notifications"
                                  IsOn="True"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Privacy" FontSize="20" FontWeight="SemiBold"/>
                    <ToggleSwitch Header="Show sender/contact name"
                                  IsOn="True"/>
                    <ToggleSwitch Header="Show message contents on lock screen"
                                  IsOn="False"/>
                    <ToggleSwitch Header="Show download details"
                                  IsOn="True"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5"
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Test" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Send a sample notification to verify that Windows accepts notifications from LockScreen Hub."
                               Opacity="0.75"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Send test notification"
                                Click="SendTestNotification_Click"/>
                        <Button Content="Open Windows lock-screen settings"
                                Click="OpenLockScreenSettings_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultText" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
